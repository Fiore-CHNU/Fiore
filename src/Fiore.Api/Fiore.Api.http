@Fiore_Api_HostAddress = http://localhost:5090
@ProductId = replace-with-a-product-id-from-the-catalogue-response
@CartId = replace-with-the-created-cart-id
@CartToken = replace-with-the-created-cart-session-token
@AccessToken = replace-with-a-jwt-from-login

GET {{Fiore_Api_HostAddress}}/health
Accept: application/json

###

GET {{Fiore_Api_HostAddress}}/api/v1/catalog/products?page=1&pageSize=12
Accept: application/json

###

GET {{Fiore_Api_HostAddress}}/api/v1/catalog/products/{{ProductId}}
Accept: application/json

###

GET {{Fiore_Api_HostAddress}}/api/v1/catalog/facets?kind=color
Accept: application/json

###

GET {{Fiore_Api_HostAddress}}/api/v1/delivery/slots?date=2026-11-24
Accept: application/json

###

POST {{Fiore_Api_HostAddress}}/api/v1/carts
Accept: application/json

###

POST {{Fiore_Api_HostAddress}}/api/v1/carts/{{CartId}}/items
X-Cart-Token: {{CartToken}}
Content-Type: application/json

{
  "productId": "{{ProductId}}",
  "quantity": 1
}

###

POST {{Fiore_Api_HostAddress}}/api/v1/checkout
X-Cart-Token: {{CartToken}}
Content-Type: application/json

{
  "cartId": "{{CartId}}",
  "contactName": "Test Customer",
  "contactEmail": "customer@example.test",
  "contactPhone": "+380501112233",
  "recipientName": "Test Recipient",
  "recipientPhone": "+380501112233",
  "city": "Chernivtsi",
  "street": "Main Street",
  "building": "1",
  "scheduledFrom": "2026-11-20T10:00:00+02:00",
  "scheduledTo": "2026-11-20T12:00:00+02:00"
}

###

GET {{Fiore_Api_HostAddress}}/api/v1/orders/replace-with-order-id-from-checkout
X-Cart-Token: {{CartToken}}
Accept: application/json

###

POST {{Fiore_Api_HostAddress}}/api/v1/orders/replace-with-order-id-from-checkout/payments/sandbox/confirm
X-Cart-Token: {{CartToken}}

###

POST {{Fiore_Api_HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "customer@example.test",
  "password": "CorrectHorseBattery1",
  "firstName": "Test",
  "lastName": "Customer"
}

###

POST {{Fiore_Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "customer@example.test",
  "password": "CorrectHorseBattery1"
}

###

GET {{Fiore_Api_HostAddress}}/api/v1/admin/orders
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

POST {{Fiore_Api_HostAddress}}/api/v1/admin/products
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "sku": "FIO-DEMO-001",
  "name": "Demo bouquet",
  "basePrice": 850,
  "quantityAvailable": 5,
  "description": "Example product for the manager panel",
  "heightCm": 45,
  "widthCm": 30,
  "composition": [
    { "flowerName": "Rose", "stemCount": 11 },
    { "flowerName": "Eucalyptus", "stemCount": 3, "note": "Seasonal greenery" }
  ],
  "images": [
    {
      "imageUrl": "https://example.test/demo-bouquet.jpg",
      "altText": "Demo bouquet"
    }
  ]
}

###

POST {{Fiore_Api_HostAddress}}/api/v1/admin/catalog/facets
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "kind": "color",
  "slug": "red",
  "name": "Red"
}
